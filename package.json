{
  "name": "loui",
  "version": "0.1.0",
  "description": "A browser Claude can drive alongside you",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "relay": "node relay/server.js",
    "test": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node --test --test-concurrency=1 test/*.test.js",
    "dist:win": "USE_SYSTEM_WINE=true PATH=\"$PWD/scripts/nowine:$PATH\" electron-builder --win --x64"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.326",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "26.18.0"
  },
  "author": "Francis Phan",
  "build": {
    "appId": "io.github.francisphan.loui",
    "productName": "Loui",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
