{
  "name": "loui",
  "version": "0.6.13",
  "description": "A browser Claude can drive alongside you",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "relay": "node relay/server.js",
    "test": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node --test --test-concurrency=1 --test-timeout=90000 --test-force-exit test/*.test.js",
    "test:integration": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node --test --test-concurrency=1 --test-timeout=240000 --test-force-exit test/integration/relay-e2e.test.js",
    "test:integration:windows": "node --test --test-concurrency=1 --test-timeout=900000 --test-force-exit test/integration/windows.test.js",
    "test:integration:debian": "node --test --test-concurrency=1 --test-timeout=900000 --test-force-exit test/integration/debian.test.js",
    "test:live": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node --test --test-concurrency=1 --test-timeout=300000 --test-force-exit test/integration/live.test.js",
    "dist:win": "USE_SYSTEM_WINE=true PATH=\"$PWD/scripts/nowine:$PATH\" electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux deb --x64 --publish never",
    "dist:relay": "node scripts/relay-deb.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.326",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@ghostery/adblocker": "^2.20.3",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "onnxruntime-node": "npm:onnxruntime-common@1.31.0-dev.20260911-2a43ec07e",
    "sharp": "npm:onnxruntime-common@1.31.0-dev.20260911-2a43ec07e"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "26.18.0"
  },
  "author": "Francis Phan",
  "homepage": "https://github.com/francisphan/loui",
  "desktopName": "loui.desktop",
  "build": {
    "appId": "io.github.francisphan.loui",
    "productName": "Loui",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/sharp/**",
      "!node_modules/onnxruntime-web/{lib,types,docs}/**",
      "!node_modules/onnxruntime-web/dist/!(ort-wasm-simd-threaded.asyncify.*)",
      "!node_modules/@huggingface/transformers/{src,types}/**",
      "!node_modules/@huggingface/transformers/dist/!(transformers.min.js)"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Loui-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "loui",
      "executableArgs": [
        "--"
      ],
      "icon": "build/icons",
      "category": "Network;WebBrowser",
      "syncDesktopName": true,
      "maintainer": "Francis Phan <francisphan@users.noreply.github.com>",
      "synopsis": "A web browser Claude drives alongside you",
      "description": "Browse the web with Claude alongside: Claude sessions work in tab groups of their own, in the same window you browse in.",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html",
        "application/xhtml+xml"
      ],
      "desktop": {
        "entry": {
          "Name": "Loui",
          "GenericName": "Web Browser",
          "StartupWMClass": "loui",
          "StartupNotify": "true"
        }
      }
    },
    "deb": {
      "artifactName": "loui_${version}_${arch}.${ext}",
      "packageCategory": "web",
      "priority": "optional",
      "afterInstall": "build/linux/after-install.sh",
      "depends": [
        "libasound2",
        "libatk-bridge2.0-0",
        "libatk1.0-0",
        "libatspi2.0-0",
        "libc6",
        "libcairo2",
        "libcups2",
        "libdbus-1-3",
        "libexpat1",
        "libgbm1",
        "libglib2.0-0",
        "libgtk-3-0",
        "libnspr4",
        "libnss3",
        "libpango-1.0-0",
        "libudev1",
        "libx11-6",
        "libxcb1",
        "libxcomposite1",
        "libxdamage1",
        "libxext6",
        "libxfixes3",
        "libxkbcommon0",
        "libxrandr2",
        "libnotify4",
        "libsecret-1-0",
        "fonts-liberation",
        "xdg-utils"
      ],
      "recommends": [],
      "fpm": [
        "--deb-suggests=xvfb",
        "--deb-suggests=pkexec",
        "build/linux/loui-headless@.service=/usr/lib/systemd/system/loui-headless@.service"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "francisphan",
        "repo": "loui",
        "releaseType": "release"
      }
    ]
  }
}
