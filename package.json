{
  "name": "loui",
  "version": "0.6.2",
  "description": "A browser Claude can drive alongside you",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "relay": "node relay/server.js",
    "test": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node --test --test-concurrency=1 --test-timeout=90000 --test-force-exit test/*.test.js",
    "test:integration": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node --test --test-concurrency=1 --test-timeout=240000 --test-force-exit test/integration/relay-e2e.test.js",
    "test:integration:windows": "node --test --test-concurrency=1 --test-timeout=900000 --test-force-exit test/integration/windows.test.js",
    "test:live": "xvfb-run -a -s \"-screen 0 1600x1000x24\" node --test --test-concurrency=1 --test-timeout=300000 --test-force-exit test/integration/live.test.js",
    "dist:win": "USE_SYSTEM_WINE=true PATH=\"$PWD/scripts/nowine:$PATH\" electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.326",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@ghostery/adblocker": "^2.20.3",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "onnxruntime-node": "npm:onnxruntime-common@1.31.0-dev.20260911-2a43ec07e",
    "sharp": "npm:onnxruntime-common@1.31.0-dev.20260911-2a43ec07e"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "26.18.0"
  },
  "author": "Francis Phan",
  "build": {
    "appId": "io.github.francisphan.loui",
    "productName": "Loui",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/sharp/**",
      "!node_modules/onnxruntime-web/{lib,types,docs}/**",
      "!node_modules/onnxruntime-web/dist/!(ort-wasm-simd-threaded.asyncify.*)",
      "!node_modules/@huggingface/transformers/{src,types}/**",
      "!node_modules/@huggingface/transformers/dist/!(transformers.min.js)"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Loui-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "francisphan",
        "repo": "loui",
        "releaseType": "release"
      }
    ]
  }
}
