# Loui on a machine with no screen: the installed browser on a virtual
# display (Xvfb), for Claude sessions that reach it through a relay. Part of
# the loui package; nothing starts it until it is enabled for a user:
#
#   sudo apt install xvfb
#   sudo systemctl enable --now loui-headless@<user>
#
# It runs as that user, with their profile in ~/.config/loui, their Downloads
# folder and their Claude Code login. /etc/default/loui-headless (optional,
# root's to read) names the relay to connect to:
#
#   LOUI_RELAY_URL=http://127.0.0.1:7332
#   LOUI_RELAY_KEY=<the relay key>
#
# See "Debian" in the README.
[Unit]
Description=Loui (headless) for %i
Documentation=https://github.com/francisphan/loui#debian
After=network-online.target loui-relay.service
Wants=network-online.target
# Without Xvfb there is nothing to draw on.
ConditionPathExists=/usr/bin/xvfb-run

[Service]
User=%i
EnvironmentFile=-/etc/default/loui-headless
# -a: the first display number that is free. Nothing listens on the network.
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1600x1000x24 -nolisten tcp" /opt/Loui/loui
# Loui quits when its last window closes; here that only means: start again.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
